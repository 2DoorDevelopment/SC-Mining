rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Session codes are globally readable so anyone can look up a session by code to join
    match /sessions/{sessionId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null && request.auth.uid in resource.data.members;
      allow delete: if false;

      match /workOrders/{orderId} {
        allow read, write: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/sessions/$(sessionId)).data.members;
      }

      match /crewMembers/{memberId} {
        allow read, write: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/sessions/$(sessionId)).data.members;
      }

      match /payouts/{payoutId} {
        allow read, write: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/sessions/$(sessionId)).data.members;
      }
    }
  }
}
